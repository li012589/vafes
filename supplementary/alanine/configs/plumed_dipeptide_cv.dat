UNITS LENGTH=nm TIME=ps ENERGY=kj/mol

WHOLEMOLECULES ENTITY0=1-13

d1: DISTANCE ATOMS=6,2 COMPONENTS NOPBC
d2: DISTANCE ATOMS=6,11 COMPONENTS NOPBC

metad: METAD ARG=d1.z,d2.z PACE=1000 HEIGHT=1.0 SIGMA=0.02,0.02 TEMP=300 BIASFACTOR=10 FILE=HILLS GRID_MIN=-0.2,-0.2 GRID_MAX=0.2,0.2 GRID_BIN=100,100

PRINT ARG=d1.z,d2.z,metad.bias STRIDE=1000 FILE=COLVAR
